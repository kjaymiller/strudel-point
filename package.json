{
  "name": "strudel-point",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter @strudel-point/gateway build && bun run --filter @strudel-point/web build && bun run --filter @strudel-point/dj build && bun run --filter @strudel-point/pads build && bun run --filter @strudel-point/patch-panel build",
    "migrate": "bun scripts/migrate.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run check && bun run typecheck && bun run test",
    "build:strudel-api": "bun scripts/build-strudel-api.ts",
    "build:strudel-vocab": "bun scripts/build-strudel-vocab.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "pg": "^8.13.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6"
  }
}
