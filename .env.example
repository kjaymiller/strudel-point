# Copy to .env alongside docker-compose.yml. Everything the dev stack needs is hardcoded
# in the compose file EXCEPT object storage, which has no local server any more — sample
# audio goes to Wasabi in dev exactly as it does in production, so these three have no
# default and `docker compose up` will refuse to start without them.
#
# Use a scratch bucket, NOT the production one: dev uploads are real objects in a real
# bucket, and Wasabi bills a minimum storage duration (90 days on the standard plan) per
# object regardless of the 1-day expiry rule that deletes it.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Wasabi's hostnames are region-scoped, so these two must agree. Defaults are us-east-1;
# see .env.prod.example for the full region/endpoint table.
S3_ENDPOINT=s3.wasabisys.com
S3_REGION=us-east-1

# Leave false when the bucket and its `samples/` expiry rule already exist (the normal
# case — a bucket-scoped key can create neither). true makes the gateway create them on
# boot; see connectStorage in apps/gateway/src/storage.ts.
S3_PROVISION=false

# The in-room chatbot (apps/gateway/src/chat/). Optional: leave empty and the dev stack
# comes up without it — the chat panel is still room chat and dropped files still become
# patterns, there's just nobody answering.
#
# Default provider is Claude, billed to your Anthropic account. To run the same room tools
# against a local model instead, set CHAT_PROVIDER=openai-compatible and point CHAT_BASE_URL
# at any chat-completions server (Ollama, vLLM, LM Studio) — see apps/gateway/.env.example.
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CHAT_MODEL=
