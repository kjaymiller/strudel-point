# Copy to .env alongside docker-compose.prod.yml and fill in. Unlike the dev stack, none
# of these have defaults — docker-compose.prod.yml uses the `${VAR:?}` form so the stack
# refuses to start rather than quietly running with a known-public password.

# Postgres superuser password for the bundled `postgres` service, and half of the
# DATABASE_URL the gateway is handed.
POSTGRES_PASSWORD=

# --- Object storage: Wasabi ---
# Sample audio bytes. Production has no bundled storage container; this points at a real
# Wasabi bucket. Create these once in the Wasabi console before first boot:
#
#   1. A bucket, in the region you want.
#   2. A lifecycle rule on it expiring the `samples/` prefix after 1 day, matching
#      SAMPLE_TTL_DAYS (the gateway does not create the rule — see S3_PROVISION below).
#   3. An access key, ideally a sub-user scoped to just that bucket.
#
# COST NOTE: Wasabi charges a minimum storage duration (90 days on the standard plan) and
# a 1TB monthly minimum. Objects deleted by the 1-day expiry rule are still billed for the
# full 90 days, so the TTL bounds how much data you hold, not what you pay. This is a very
# different cost shape than the RustFS volume it replaces, where storage was just disk.
#
# S3_ENDPOINT must match S3_REGION — Wasabi's hostnames are region-scoped. Pairs:
#   us-east-1      -> s3.wasabisys.com
#   us-east-2      -> s3.us-east-2.wasabisys.com
#   us-west-1      -> s3.us-west-1.wasabisys.com
#   eu-central-1   -> s3.eu-central-1.wasabisys.com
#   ap-northeast-1 -> s3.ap-northeast-1.wasabisys.com
# (full list: https://docs.wasabi.com/docs/what-are-the-service-urls-for-wasabis-different-storage-regions)
S3_ENDPOINT=s3.wasabisys.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Leave false when the bucket + lifecycle rule already exist (the setup above), which is
# the normal case: a bucket-scoped key has no rights to create either. Set true only if
# this key may CreateBucket and PutBucketLifecycle, and you'd rather the gateway own it.
S3_PROVISION=false

# Host port for the single published origin (caddy). Whatever TLS-terminating proxy you
# put in front points here.
HTTP_PORT=8088

# Leave empty unless you are serving the apps from a different origin than the gateway.
# In the default single-origin deployment the browser never makes a cross-origin request,
# so no allowlist is needed.
CORS_ORIGIN=

# OTLP/HTTP base URL of your collector, e.g. http://otel-collector:4318. Leave empty to
# disable tracing entirely (telemetry.ts no-ops).
OTEL_EXPORTER_OTLP_ENDPOINT=

# The in-room chatbot (apps/gateway/src/chat/). Leave empty to deploy without it — chat and
# byte sonification keep working, there's just no bot answering. Billed per turn against
# your Anthropic account, and every person in the room can talk to it.
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional on this provider; defaults to claude-opus-5.
CHAT_MODEL=

# Or point the same room tools at any OpenAI-compatible server — a self-hosted model has no
# per-turn bill, which matters more here than in dev given rooms are open to whoever has the
# URL. CHAT_MODEL is required in this mode.
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=http://vllm:8000/v1
# CHAT_MODEL=
# CHAT_API_KEY=

# Reasoning models can spend most of a turn on thinking tokens that never reach the room,
# and a chat panel beside a live-coding editor is somewhere latency is felt directly. Set
# true to have the server render the prompt with thinking off (`chat_template_kwargs:
# {enable_thinking: false}` — vLLM, MLX and Ollama on the Qwen family read it). Left false
# by default because it is a chat-template passthrough, not part of the OpenAI protocol:
# a server that does not know the field may reject the whole request rather than ignore it.
# CHAT_DISABLE_THINKING=false
