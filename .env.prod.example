# Copy to .env alongside docker-compose.prod.yml and fill in. Unlike the dev stack, none
# of these have defaults — docker-compose.prod.yml uses the `${VAR:?}` form so the stack
# refuses to start rather than quietly running with a known-public password.

# Postgres superuser password for the bundled `postgres` service, and half of the
# DATABASE_URL the gateway is handed.
POSTGRES_PASSWORD=

# Object-storage credentials. Set on the RustFS server AND handed to the gateway's S3
# client, so the two always agree — they are one credential, named from both ends.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Host port for the single published origin (caddy). Whatever TLS-terminating proxy you
# put in front points here.
HTTP_PORT=8088

# Leave empty unless you are serving the apps from a different origin than the gateway.
# In the default single-origin deployment the browser never makes a cross-origin request,
# so no allowlist is needed.
CORS_ORIGIN=

# OTLP/HTTP base URL of your collector, e.g. http://otel-collector:4318. Leave empty to
# disable tracing entirely (telemetry.ts no-ops).
OTEL_EXPORTER_OTLP_ENDPOINT=
