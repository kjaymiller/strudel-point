# Local defaults match docker-compose.yml — copy to .env and only change what you need.

PORT=8787
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://strudel:strudel@localhost:5433/strudel_point

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=strudel-point-gateway

# --- Aiven for Apache Kafka (uncomment/fill when pointing at Aiven instead of local) ---
# KAFKA_BROKERS=<service-name>-<project>.aivencloud.com:<port>
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=<from Aiven console>

# --- Aiven for PostgreSQL ---
# DATABASE_URL=postgres://avnadmin:<password>@<service-name>-<project>.aivencloud.com:<port>/defaultdb?sslmode=require

# Custom-sample audio bytes — object storage, 24h fixed expiry via a bucket lifecycle
# rule (see apps/gateway/src/storage.ts). Defaults match docker-compose.yml's local RustFS.
# Named generically (S3_*) since the client is just an S3-protocol client — same vars work
# unmodified against RustFS, Wasabi, MinIO, AWS S3, or anything else S3-compatible.
S3_ENDPOINT=localhost
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY=strudel
S3_SECRET_KEY=strudel-dev-secret
S3_BUCKET=custom-samples
SAMPLE_TTL_DAYS=1
# The local container starts empty, so the gateway creates the bucket and its expiry rule
# on boot. Against a managed bucket set this false — see the Wasabi block below.
S3_PROVISION=true

# Cross-instance presence + the autosave write buffer (see apps/gateway/src/valkey.ts).
# Optional: with nothing listening here the gateway still runs — presence degrades to
# per-instance and autosave writes straight through to Postgres.
VALKEY_URL=valkey://localhost:6379

# The in-room chatbot (apps/gateway/src/chat/). Leave unset to run without it: the chat
# panel is still room chat, dropped files still become patterns, and GET /api/chat/status
# reports enabled:false *with the reason* so the UI can say why nobody's answering.
# Credentials are the only thing that can turn it on, so there is no separate enable flag.
#
# The room tools are provider-neutral (apps/gateway/src/chat/types.ts) — only the transport
# below changes.

# --- Claude (default) ---
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5 on this provider.
CHAT_MODEL=

# --- Anything speaking OpenAI chat-completions (Ollama, vLLM, LM Studio, OpenRouter, OpenAI) ---
# CHAT_MODEL has no default here — it depends entirely on what's loaded into the server
# CHAT_BASE_URL points at, and a Claude model id sent to a local Ollama is an unreadable 404.
# CHAT_API_KEY is optional: a local Ollama or LM Studio checks nothing.
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=llama3.1
# CHAT_API_KEY=

# Reasoning models can spend most of a turn on thinking tokens that never reach the room,
# and a chat panel beside a live-coding editor is somewhere latency is felt directly. Set
# true to have the server render the prompt with thinking off (`chat_template_kwargs:
# {enable_thinking: false}` — vLLM, MLX and Ollama on the Qwen family read it). Left false
# by default because it is a chat-template passthrough, not part of the OpenAI protocol:
# a server that does not know the field may reject the whole request rather than ignore it.
# CHAT_DISABLE_THINKING=false

# --- Aiven for Valkey ---
# Use the service URI straight from the Aiven console; the `valkeys://` (or `rediss://`)
# scheme turns TLS on by itself, no extra config needed.
# VALKEY_URL=valkeys://default:<password>@<service-name>-<project>.aivencloud.com:<port>

# --- Wasabi (what docker-compose.prod.yml uses) ---
# No Aiven-managed equivalent exists for object storage, unlike Kafka/PostgreSQL above.
# The endpoint host is region-scoped and must agree with S3_REGION; create the bucket and
# its `samples/` expiry rule in the Wasabi console first, then leave S3_PROVISION=false
# since a bucket-scoped key can't create either. See .env.prod.example for the region
# table and the minimum-storage-duration billing caveat.
# S3_ENDPOINT=s3.wasabisys.com
# S3_REGION=us-east-1
# S3_PORT=443
# S3_USE_SSL=true
# S3_ACCESS_KEY=<access key>
# S3_SECRET_KEY=<secret key>
# S3_PROVISION=false

# --- Any other S3-compatible provider (MinIO, AWS S3, RustFS hosted elsewhere) ---
# Same five vars; only the endpoint/region pair changes.
